--- a/packages/tui/src/render/status-line.ts
+++ b/packages/tui/src/render/status-line.ts
@@ -3,6 +3,7 @@
  */
 import type { Theme, ThemeColor } from "../theme/theme";
 import { formatStatusIcon, type ToolUIStatus } from "./render-utils";
+import { replaceTabs, truncateToWidth, visibleWidth } from "../utils";
 
 /** Status icon, title, description, and metadata for a single header row. */
 export interface StatusLineOptions {
@@ -19,11 +20,9 @@ export interface StatusLineOptions {
 }
 
 /**
- * Flatten CR/LF runs in caller-supplied header fragments so a single newline
- * embedded in `description` or `meta` cannot expand the status line into
- * multiple rows — which would otherwise break the bordered output block the
- * header sits on. Tab characters are left alone; tool renderers that need
- * tab-safe text run `replaceTabs()` themselves.
+ * Flatten CR/LF runs in caller-supplied header fragments so one embedded
+ * newline cannot expand a single-line header into multiple rows. Tabs remain
+ * the caller's responsibility when display normalization is required.
  */
 function flattenForHeader(text: string): string {
 	return text.replace(/\r\n?|\n/g, " ");
@@ -53,3 +52,38 @@ export function renderStatusLine(options: StatusLineOptions, theme: Theme): stri
 
 	return line;
 }
+
+/** Opt-in compact receipt header; existing status-line callers keep their layout. */
+export function renderCompactToolHeader(
+	options: {
+		icon: string;
+		name: string;
+		target: string;
+		facts: string[];
+		fitTarget: (text: string, width: number) => string;
+	},
+	theme: Theme,
+	width: number,
+): string {
+	const icon = options.icon;
+	const title = theme.fg("accent", theme.bold(`[${replaceTabs(flattenForHeader(options.name))}]`));
+	const prefix = `${icon} ${title}`;
+	const remaining = Math.max(0, width - visibleWidth(prefix) - 1);
+	const targetText = replaceTabs(flattenForHeader(options.target));
+	const factText = options.facts.map(fact => replaceTabs(flattenForHeader(fact))).join(theme.sep.dot);
+	const factWidth = Math.min(visibleWidth(factText), targetText ? Math.floor(remaining * 0.6) : remaining);
+	const facts = factWidth > 0 ? theme.fg("dim", truncateToWidth(factText, factWidth)) : "";
+	const separator = targetText && facts ? theme.sep.dot : "";
+	const targetWidth = Math.max(0, remaining - visibleWidth(separator) - visibleWidth(facts));
+	const target = options.fitTarget(targetText, targetWidth);
+	const details = `${target}${target && facts ? separator : ""}${facts}`;
+	return truncateToWidth(details ? `${prefix} ${details}` : prefix, width);
+}
+
+/** Nest unprefixed leaf excerpts beneath a compact receipt without touching structured trees. */
+export function renderCompactToolResults(lines: readonly string[], theme: Theme, width: number): string[] {
+	return lines.map((line, index) => {
+		const branch = index === lines.length - 1 ? theme.tree.hook : theme.tree.vertical;
+		return truncateToWidth(`  ${theme.fg("dim", branch)} ${replaceTabs(line)}`, width);
+	});
+}
